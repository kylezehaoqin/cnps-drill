# /etc/nginx/sites-available/drill.example.com
server {
    listen 80;
    server_name drill.example.com;
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    server_name drill.example.com;

    ssl_certificate     /etc/letsencrypt/live/drill.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/drill.example.com/privkey.pem;

    # Anyone with the URL can read and overwrite a profile. If the box is
    # public, uncomment these two lines and create the file with:
    #   sudo htpasswd -c /etc/nginx/.htpasswd kim
    # auth_basic           "Drill";
    # auth_basic_user_file /etc/nginx/.htpasswd;

    client_max_body_size 8m;

    location / {
        proxy_pass         http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # Cached plates are immutable; let the browser keep them.
    location /photos/ {
        proxy_pass       http://127.0.0.1:8080;
        proxy_set_header Host $host;
        expires          30d;
        add_header       Cache-Control "public, immutable";
    }
}
